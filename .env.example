# RUN QUEST 2026 — environment config
# Copy this file to `.env` and change the values before deploying.

# Admin CMS credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Secret used to sign session cookies. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-long-random-secret

# Optional: session lifetime in hours (default 12)
SESSION_HOURS=12

# Optional: server port (default 3000)
PORT=3000
